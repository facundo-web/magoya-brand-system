{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "brand": "Magoya",
    "version": "1.1",
    "description": "Design tokens oficiales de Magoya — AgTech digital product studio. Fuente de verdad junto a tokens.css y BRAND.md.",
    "updated": "2026-08-04"
  },
  "color": {
    "green": {
      "950": { "value": "#0C2117", "role": "fondo oscuro más profundo" },
      "900": { "value": "#133825", "role": "Verde Magoya oficial — core institucional, overlays, superficies dark", "official": true },
      "800": { "value": "#1A4A31", "role": "superficie elevada sobre dark" },
      "700": { "value": "#235F40", "role": "bordes / hover sobre dark" }
    },
    "emerald": {
      "400": { "value": "#33E886" },
      "500": { "value": "#00DE68", "role": "Verde digital — wordmark, avatares, micro-acentos. Como texto SOLO sobre fondos oscuros", "official": true },
      "600": { "value": "#00B856", "role": "hover" },
      "700": { "value": "#009145", "role": "verde texto sobre blanco — SOLO texto grande ≥24px bold (4.1:1)" }
    },
    "lime": {
      "300": { "value": "#CBF06E", "role": "marcador suave editorial" },
      "400": { "value": "#B6E84F" },
      "500": { "value": "#A2FF00", "role": "Lima energía — CTA, display, motivo. Dosis única por pieza. NUNCA como texto sobre blanco (1.25:1)", "official": true },
      "600": { "value": "#8BDB00", "role": "hover de lima" }
    },
    "leaf": {
      "300": { "value": "#88E755" },
      "500": { "value": "#33DB4E", "role": "verde ilustración (ropa de personajes) y soporte data-viz", "official": true },
      "700": { "value": "#309E3A", "role": "data-viz oscuro (derivado)" }
    },
    "cream": {
      "50":  { "value": "#F6F1EB" },
      "100": { "value": "#ECE3DB", "role": "Crema Magoya oficial — neutro cálido, texto sobre verde profundo", "official": true },
      "200": { "value": "#DCD0C4" },
      "300": { "value": "#C4B5A6" }
    },
    "paper": {
      "50":  { "value": "#F7F4EF" },
      "100": { "value": "#F1EDE7", "role": "canvas editorial greige" },
      "200": { "value": "#E6E1D8" }
    },
    "sage": {
      "50":  { "value": "#EEF2EC", "role": "superficie sage de módulos de slides", "official": true },
      "100": { "value": "#E3EAE0" }
    },
    "ink": {
      "950": { "value": "#0D0C0C", "role": "negro logo" },
      "900": { "value": "#161616", "role": "Negro Magoya — texto y titulares, cards dark", "official": true }
    },
    "gray": {
      "800": { "value": "#222222" },
      "600": { "value": "#666666", "role": "texto secundario sobre claro" },
      "400": { "value": "#AAAAAA", "role": "solo decorativo — NO texto" },
      "300": { "value": "#D0D0D0" },
      "200": { "value": "#DFDFDF", "role": "gris ropa de personajes (solo ilustración)" },
      "100": { "value": "#EFEFEF" }
    },
    "peach": {
      "300": { "value": "#FFC67B", "role": "piel de personajes — SOLO ilustración, nunca UI" }
    },
    "white": { "value": "#FFFFFF" },
    "functional": {
      "info":    { "value": "#2E7DD1" },
      "warning": { "value": "#E0A33A" },
      "danger":  { "value": "#D8514E" },
      "textSubtleOnLight": { "value": "#6E756D", "role": "captions sobre claro (4.5:1)" },
      "hairline": { "value": "#E7E7E2", "role": "bordes finos sobre claro" },
      "canvasMeta": { "value": "#E9E9E5", "role": "fondo de páginas-catálogo" }
    },
    "illustrationPalette": {
      "description": "Paleta CERRADA de personajes — exactamente estos 5, nada más",
      "values": ["#33DB4E", "#A2FF00", "#DFDFDF", "#FFC67B", "#161616"]
    },
    "usageRatio": {
      "description": "El negro construye, el verde hace crecer. Guía por pieza",
      "whiteSage": 52, "black": 23, "deepGreen": 13, "lime": 8, "emerald": 4
    }
  },
  "typography": {
    "family": {
      "primary": { "value": "Manrope", "source": "assets/font/manrope/Manrope-VariableFont_wght.ttf", "weights": "200-800" },
      "fallback": { "value": "Arial", "when": "docs, mails, entornos sin Manrope" }
    },
    "scale": {
      "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.25rem",
      "xl": "1.563rem", "2xl": "1.953rem", "3xl": "2.441rem", "4xl": "3.052rem",
      "5xl": "3.815rem", "6xl": "4.768rem", "7xl": "5.96rem"
    },
    "slideScale": {
      "description": "Escala del sistema de slides, relativa a slide de 1920px",
      "hero": "126pt", "display": "84pt", "title": "56pt", "subtitle": "42pt"
    },
    "display": { "weight": 800, "letterSpacing": "-0.03em", "lineHeight": 1.05 },
    "body": { "weight": 400, "lineHeight": 1.55 },
    "kicker": { "weight": 800, "letterSpacing": "0.12em", "transform": "uppercase" },
    "rules": [
      "Máximo 3 niveles tipográficos por pieza",
      "El peso hace la jerarquía (800 grita, 400 explica)",
      "Labels de botón en sentence case, nunca MAYÚSCULAS",
      "Resaltado: color (#009145 sobre claro solo ≥24px bold; lima sobre oscuro) o subrayado lima. PROHIBIDO bloque resaltador sólido"
    ]
  },
  "spacing": { "base": "4px", "scale": [4, 8, 12, 16, 24, 32, 48, 64, 96] },
  "radius": {
    "sm": "6px", "md": "12px", "lg": "20px", "xl": "28px", "full": "999px",
    "button": { "value": "10px", "rule": "botón = rectángulo radio leve; chip = pill outline (999px, borde+texto mismo color, fondo transparente)" }
  },
  "layout": {
    "slide": { "aspect": "16:9", "export": "1920x1080", "innerMargin": "7% del ancho, todos los lados" },
    "social": { "feed": "1080x1080", "story": "1080x1920 (zona segura 96px sup/inf)" },
    "logoMinWidth": { "screen": "90px", "print": "24mm", "below": "usar avatar m" },
    "logoClearspace": "altura de la letra m en todos los lados"
  },
  "assets": {
    "wordmarks": ["assets/magoya-wordmark-green.svg", "assets/magoya-wordmark-cream.svg", "assets/magoya-wordmark-black.svg", "assets/magoya-wordmark-deep.svg"],
    "avatars": ["assets/avatars/avatar-go.svg", "assets/avatars/avatar-o.svg", "assets/avatars/avatar-face.svg", "assets/avatars/avatar-m.svg"],
    "motifs": ["assets/motif-semis.svg", "assets/motif-semis-band.svg"],
    "characters": ["assets/illus/char-laptop.svg", "assets/illus/char-jumping.svg", "assets/illus/char-experts-talking.svg", "assets/illus/char-chart-duo.svg"],
    "photos": ["assets/photos/field-rows.jpg", "assets/photos/field-terraces.jpg", "assets/photos/field-bali.jpg", "assets/photos/field-corn.jpg", "assets/photos/founder-bw.png", "assets/photos/team-couple-bw.jpg"],
    "clientLogos": "assets/logos/clients/",
    "partnerLogos": "assets/logos/partners/",
    "iconLibrary": "icons.html (58 iconos inline SVG, stroke 2px round, 24x24)"
  }
}
